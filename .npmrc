# Portable monorepo settings (Windows + Linux GHA).
# Do NOT commit absolute store-dir paths — they break actions/setup-node
# `cache: pnpm` post-steps on ubuntu-latest ("Path(s) … do not exist").
#
# Local Windows (exFAT / no symlinks on D:): set your store on C: once:
#   pnpm config set store-dir "$env:LOCALAPPDATA\pnpm-store" --global
node-linker=hoisted
symlink=false
virtual-store-dir-max-length=60
