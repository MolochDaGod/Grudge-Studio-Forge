{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@workspace/api-client-react": ["./src/lib/cloud/dataLayer.ts"],
      "@workspace/scene-schema": ["../../lib/scene-schema/src/index.ts"],
      "@workspace/scene-templates": ["../../lib/scene-templates/src/index.ts"],
      "@workspace/object-storage-web": ["../../lib/object-storage-web/src/index.ts"],
      "@workspace/desktop-bridge": ["../../lib/desktop-bridge/src/index.ts"]
    }
  }
}
