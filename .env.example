# ============================================
# Grudge Forge — Environment Variables
# ============================================
# Copy to .env and fill in values from your Grudge ecosystem.
# NEVER commit the real .env file.

# ── Server ───────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Database (shared Grudge PostgreSQL) ──────────────────────────
# Same DATABASE_URL used by grudge-studio monorepo api-server.
# Forge tables are prefixed `forge_*` and coexist with all other tables.
DATABASE_URL=postgresql://user:password@host:5432/grudge?sslmode=require

# ── AI — Anthropic (server-side Claude) ──────────────────────────
# Direct Anthropic key (Railway / VPS / local)
ANTHROPIC_API_KEY=sk-ant-api03-...
# Optional: route through Grudge AI Gateway instead of direct Anthropic
# AI_GATEWAY_URL=https://ai.grudge-studio.com
# GRUDGE_AUTH_TOKEN=your-grudge-jwt

# ── Cloudflare R2 — Object Storage ───────────────────────────────
# Native S3 endpoint: https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com
# Same credentials used across all Grudge Studio services.
CF_ACCOUNT_ID=your_cloudflare_account_id
OBJECT_STORAGE_KEY=your_r2_access_key_id
OBJECT_STORAGE_SECRET=your_r2_secret_access_key
R2_BUCKET_ASSETS=grudge-assets

# Optional: public CDN URLs for R2 objects
OBJECT_STORAGE_PUBLIC_URL=https://assets.grudge-studio.com
# OBJECT_STORAGE_PUBLIC_R2_URL=https://pub-<your-r2-bucket-id>.r2.dev

# ── Puter Auth ───────────────────────────────────────────────────
# Session-less auth: Puter SDK runs client-side, server verifies tokens.
PUTER_SITE_ORIGIN=https://puter.com
PUTER_BASE_PATH=/grudge-forge
PUTER_API_BASE=https://api.puter.com
ENABLE_PUTER_CLOUD=true
GRUDGE_AUTH_URL=https://id.grudge-studio.com

# ── Cloudflare Workers AI (text-to-image, text gen, vision) ───
# Requires a Cloudflare API token with Workers AI Read + Edit permissions.
# Uses CF_ACCOUNT_ID above for the account identifier.
CF_AI_API_TOKEN=your_cloudflare_ai_api_token

# ── Notes ────────────────────────────────────────────────────────
# All object storage uses Cloudflare R2 via the vars above.
# All auth routes through Grudge ID at GRUDGE_AUTH_URL.
# See grudge-stack and grudge-fleet skills for deployment topology.
