# ============================================
# Grudge Forge — Environment Variables
# ============================================
# Copy to .env and fill in values from your Grudge ecosystem.
# NEVER commit the real .env file.
#
# Production SPA: forge.grudge-studio.com
# Architecture: Puter KV+FS for editor projects, R2 CDN for binaries,
# Railway Postgres for player bag (NOT Forge D1), free-ai edge for agents.
#
# Toolchain: Node >=22.12 + pnpm 10.32 (package.json engines / packageManager)
# 3D pin: three 0.185.1 · @dimforge/rapier3d ^0.19.3 · R3F catalog (pnpm-workspace)
# Quality system (optional): @grudge-studio/* ^0.3.0 — see grudge-studio-npm skill

# ── Server (dev only) ────────────────────────────────────────────
PORT=8080
NODE_ENV=development
# Vite base (production build defaults to "/")
BASE_PATH=/

# ── Puter Auth + Cloud Storage (editor projects / L7 playtest) ───
PUTER_SITE_ORIGIN=https://puter.com
PUTER_BASE_PATH=/GRUDACHAIN
PUTER_API_BASE=https://api.puter.com
ENABLE_PUTER_CLOUD=true
GRUDGE_AUTH_URL=https://id.grudge-studio.com

# ── Fleet origins (client-visible; no secrets) ───────────────────
VITE_ASSETS_CDN=https://assets.grudge-studio.com
VITE_OBJECTSTORE_URL=https://objectstore.grudge-studio.com
VITE_GRUDGE_ID_URL=https://id.grudge-studio.com
VITE_AI_GATEWAY_URL=https://ai.grudge-studio.com
VITE_FORGE_ORIGIN=https://forge.grudge-studio.com
# Live play shells editable from Forge (see gameDeployments FLEET_GAME_DEFS)
VITE_WARGUS_URL=https://grudge-studio.com/wargus
VITE_WARLORDS_CLIENT_URL=https://client.grudge-studio.com
VITE_OPEN_LAUNCHER_URL=https://open.grudge-studio.com

# ── Cloudflare R2 — Builtin Asset CDN ────────────────────────────
CF_ACCOUNT_ID=your_cloudflare_account_id
OBJECT_STORAGE_PUBLIC_URL=https://assets.grudge-studio.com
OBJECT_STORAGE_PUBLIC_R2_URL=https://pub-e7fcf1fd4c9946ecb84b3766bbc7b50d.r2.dev
R2_BUCKET_ASSETS=grudge-assets

# Legacy api-server / Railway forge-api (optional local):
# OBJECT_STORAGE_KEY=your_r2_access_key_id
# OBJECT_STORAGE_SECRET=your_r2_secret_access_key
# ANTHROPIC_API_KEY=sk-ant-api03-...
# DATABASE_URL=postgresql://...
# FORGE_API_URL=https://forge.grudge-studio.com/api

# ── Cloudflare Workers AI (optional — image gen, vision) ─────────
CF_AI_API_TOKEN=your_cloudflare_ai_api_token

# ── AI Brain — D1 + GitHub research (optional) ───────────────────
# CF_D1_DATABASE_ID=your_d1_database_uuid
# CF_D1_API_TOKEN=your_token_with_d1_read
# GITHUB_TOKEN=ghp_...

# ── Vercel deploy (scripts/deploy-forge-vercel.mjs) ──────────────
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# VERCEL_PROJECT=grudge-studio-forge
# VERCEL_SCOPE=grudgenexus

# ── CORS (api-server) ────────────────────────────────────────────
CORS_ORIGINS=https://forge.grudge-studio.com,https://grudge-studio.com,https://app.puter.com,https://open.grudge-studio.com

# ── Notes / SSOT ─────────────────────────────────────────────────
# L-PLAYER bag/XP: Railway grudge-api — never Forge D1
# L-BIN meshes: assets.grudge-studio.com (never bundle_in_spa)
# L-DEFS catalogs: objectstore.grudge-studio.com/api/v1
# Editor projects:
#   Guest → localStorage + IndexedDB (projectStorage.ts)
#   Puter signed-in → KV grudge:forge:* + FS Grudge/forge/*
#   migrate_local_projects_to_puter after sign-in
# Edge free-ai worker (workers/forge-free-ai):
#   /api/free-ai/* chat proxy · /api/catalog/* · /api/agent/* (D1 jobs)
# AI brain: /api/knowledge/* (D1 research + docs) — not player bag
# Playtest: L7 puter_host | player_embed
# Deploy game: fleet_satellite + grudge-game-onboarding
# Chunking: vendor-3d (no TLA) ≠ vendor-rapier (TLA) — docs/3d-dependencies.md
# Windows exFAT: .npmrc node-linker=hoisted; vite aliases for @workspace/*
# Skills: forge-editor · grudge-studio-npm · forge-gameplay-scripts · grudge-fleet
