# ============================================
# Grudge Forge — Environment Variables
# ============================================
# Copy to .env and fill in values from your Grudge ecosystem.
# NEVER commit the real .env file.
#
# Architecture: Puter KV+FS for user data, Puter AI for models,
# Ollama for offline AI, R2 CDN for builtin assets. No api-server needed.

# ── Server (dev only, not needed for production) ─────────────────
PORT=8080
NODE_ENV=development

# ── Puter Auth + Cloud Storage ───────────────────────────────────
# Session-less: Puter SDK runs client-side, user data in Puter KV+FS.
PUTER_SITE_ORIGIN=https://puter.com
PUTER_BASE_PATH=/GRUDACHAIN
PUTER_API_BASE=https://api.puter.com
ENABLE_PUTER_CLOUD=true
GRUDGE_AUTH_URL=https://id.grudge-studio.com

# ── Cloudflare R2 — Builtin Asset CDN ────────────────────────────
# Public CDN for builtin 3D models, textures, templates.
# No API key needed client-side — these are fetched via direct URL.
CF_ACCOUNT_ID=your_cloudflare_account_id
OBJECT_STORAGE_PUBLIC_URL=https://assets.grudge-studio.com
OBJECT_STORAGE_PUBLIC_R2_URL=https://pub-e7fcf1fd4c9946ecb84b3766bbc7b50d.r2.dev
R2_BUCKET_ASSETS=grudge-assets

# Only needed if running the legacy api-server locally:
# OBJECT_STORAGE_KEY=your_r2_access_key_id
# OBJECT_STORAGE_SECRET=your_r2_secret_access_key
# ANTHROPIC_API_KEY=sk-ant-api03-...
# DATABASE_URL=postgresql://...

# ── Cloudflare Workers AI (optional — image gen, vision) ─────────
CF_AI_API_TOKEN=your_cloudflare_ai_api_token

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=https://forge.grudge-studio.com,https://grudge-studio.com,https://app.puter.com

# ── Notes ────────────────────────────────────────────────────────
# User data: Puter KV + FS (projects, scenes, scripts, assets)
# AI: Puter AI (9 free models) + Ollama (offline, local)
# Builtin assets: Static R2 CDN at assets.grudge-studio.com
# Auth: Puter client-side auth (no server-side session)
# See grudge-stack and grudge-fleet skills for deployment topology.
