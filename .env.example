# ============================================
# Grudge GameForge — Environment Variables
# ============================================
# Copy to .env and fill in values from your Grudge ecosystem.
# NEVER commit the real .env file.

# ── Server ───────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development

# ── Database (shared Grudge PostgreSQL) ──────────────────────────
# Same DATABASE_URL used by grudge-studio monorepo api-server.
# Forge tables are prefixed `forge_*` and coexist with all other tables.
DATABASE_URL=postgresql://user:password@host:5432/grudge?sslmode=require

# ── AI — Anthropic (server-side Claude) ──────────────────────────
# Option 1: Direct Anthropic key (Railway / VPS / local)
ANTHROPIC_API_KEY=sk-ant-api03-...
# Option 2: Replit AI Integrations (auto-provisioned on Replit)
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=

# ── Cloudflare R2 — Object Storage ───────────────────────────────
# Native S3 endpoint: https://<CF_ACCOUNT_ID>.r2.cloudflarestorage.com
# Same credentials used across all Grudge Studio services.
CF_ACCOUNT_ID=your_cloudflare_account_id
OBJECT_STORAGE_KEY=your_r2_access_key_id
OBJECT_STORAGE_SECRET=your_r2_secret_access_key
R2_BUCKET_ASSETS=grudge-assets

# Optional: public CDN URLs for R2 objects
OBJECT_STORAGE_PUBLIC_URL=https://assets.grudge-studio.com
OBJECT_STORAGE_PUBLIC_R2_URL=https://pub-xxxxx.r2.dev

# ── Puter Auth ───────────────────────────────────────────────────
# Session-less auth: Puter SDK runs client-side, server verifies tokens.
PUTER_SITE_ORIGIN=https://puter.com
PUTER_BASE_PATH=/grudge-gameforge
PUTER_API_BASE=https://api.puter.com
ENABLE_PUTER_CLOUD=true
GRUDGE_AUTH_URL=https://id.grudge-studio.com

# ── Replit Object Storage (legacy, used by /storage/* routes) ────
# Only needed if running on Replit or using GCS-based object storage.
# PUBLIC_OBJECT_SEARCH_PATHS=
# PRIVATE_OBJECT_DIR=
